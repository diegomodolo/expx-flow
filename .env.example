# ─────────────────────────────────────────────────────────────
# Expx Flow — Variáveis de ambiente (self-hosting)
# Copie este arquivo para .env e preencha com os dados da SUA instalação.
# Todas as demais integrações (IA, Meta, Google, Email, etc.)
# são configuradas via UI em /configuracoes/sistema.
# ─────────────────────────────────────────────────────────────

# ── Supabase (OBRIGATÓRIO) ───────────────────────────────────
# Encontre em: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# ── OAuth Apps (opcional — pode configurar via UI) ──────────
# Útil quando o OAuth precisa redirecionar antes de qualquer busca de banco.
VITE_FACEBOOK_APP_ID=
VITE_GOOGLE_ADS_CLIENT_ID=
VITE_GOOGLE_MEET_CLIENT_ID=
